{
  "name": "v90",
  "version": "0.1.0",
  "private": true,
  "description": "V90 – 90 günlük hipertrofi challenge uygulaması (specification: ../docs/v90/)",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "gen:migration": "python3 scripts/extract-migration.py",
    "gen:seed": "python3 scripts/extract-seed.py",
    "gen": "npm run gen:migration && npm run gen:seed && npm run gen:i18n",
    "verify:seed": "node --no-warnings scripts/verify-seed.mjs",
    "verify:drift": "python3 scripts/check-drift.py",
    "verify": "npm run verify:drift && npm run verify:seed && npm run typecheck && npm run typecheck:app && npm test && npm run verify:bundle",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --no-warnings --test \"test/**/*.test.ts\"",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "typecheck:app": "tsc --noEmit -p tsconfig.app.json",
    "bundle:check": "expo export --platform ios --output-dir .expo/export-check --no-minify --no-bytecode",
    "gen:i18n": "python3 scripts/extract-i18n.py",
    "verify:bundle": "npm run bundle:check && node --no-warnings scripts/check-bundle.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@journeyapps/sqlcipher": "^6.0.0",
    "@types/node": "^22.20.2",
    "babel-preset-expo": "^57.0.11",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "expo": "^57.0.22",
    "expo-constants": "^57.0.18",
    "expo-crypto": "^57.0.3",
    "expo-document-picker": "^57.0.2",
    "expo-file-system": "^57.0.7",
    "expo-haptics": "^57.0.3",
    "expo-image-picker": "^57.0.17",
    "expo-local-authentication": "^57.0.3",
    "expo-notifications": "^57.0.18",
    "expo-router": "^57.0.21",
    "expo-secure-store": "^57.0.4",
    "expo-sharing": "^57.0.19",
    "expo-sqlite": "^57.0.3",
    "expo-status-bar": "^57.0.1",
    "fflate": "^0.8.3",
    "react": "^19.2.0",
    "react-native": "^0.83.0",
    "react-native-gesture-handler": "^3.3.0",
    "react-native-reanimated": "^4.6.0",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-screens": "^4.27.0",
    "zod": "^4.6.2"
  },
  "main": "expo-router/entry"
}
