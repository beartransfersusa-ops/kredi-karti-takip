{
  "name": "v90",
  "version": "0.1.0",
  "private": true,
  "description": "V90 – 90 günlük hipertrofi challenge uygulaması (specification: ../docs/v90/)",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "gen:migration": "python3 scripts/extract-migration.py",
    "gen:seed": "python3 scripts/extract-seed.py",
    "gen": "npm run gen:migration && npm run gen:seed",
    "verify:seed": "node --no-warnings scripts/verify-seed.mjs",
    "verify:drift": "python3 scripts/check-drift.py",
    "verify": "npm run verify:drift && npm run verify:seed && npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "test": "node --no-warnings --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "zod": "^4.6.2"
  }
}
